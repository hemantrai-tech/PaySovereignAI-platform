# PaySovereignAI demo credentials — keep this file private and out of GitHub.
# OpenAI: create an API key in the OpenAI platform dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayPal Developer Dashboard > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Local app return origin. Set this to the public HTTPS Netlify URL when hosted.
APP_ORIGIN=http://127.0.0.1:8000

# Local server settings; Render supplies HOST and PORT automatically.
HOST=127.0.0.1
PORT=8000
HTTPS=0
